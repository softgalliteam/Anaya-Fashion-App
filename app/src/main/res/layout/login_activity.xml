<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:ignore="ContentDescription,MissingConstraints">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/bg_top" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/bg_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        android:src="@drawable/transparent_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/loginTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="250dp"
        android:text="@string/login"
        android:textColor="@color/black"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--    Add TextInputEditText for phone number input-->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/phoneTil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_50dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/margin_50dp"
        android:outlineAmbientShadowColor="@color/yellow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loginTv">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/phoneNumberEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:hint="@string/enter_phone_number"
            android:inputType="phone"
            android:maxLength="10"
            android:textColor="@color/yellow"
            android:textColorHint="@color/yellow"
            android:textSize="20sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!--Send OTP-->
    <Button
        android:id="@+id/sendOtpBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16dp"
        android:backgroundTint="@color/yellow"
        android:text="@string/send_otp"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/phoneTil"
        app:layout_constraintStart_toStartOf="@id/phoneTil"
        app:layout_constraintTop_toBottomOf="@+id/phoneTil" />

<!--Timer-->

    <TextView
        android:id="@+id/timerTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="60 sec"
        android:textColor="@color/black"
        android:visibility="gone"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toBottomOf="@+id/verifyOtpBtn"
        app:layout_constraintStart_toEndOf="@id/verifyOtpBtn"
        app:layout_constraintEnd_toEndOf="@+id/verifyOtpBtn"/>

<!--Resend OPT-->
    <Button
        android:id="@+id/resendOtpBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend OTP"
        android:visibility="gone"
        android:backgroundTint="@color/yellow"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toBottomOf="@+id/timerTv"
        app:layout_constraintStart_toEndOf="@id/verifyOtpBtn"
        app:layout_constraintEnd_toEndOf="@+id/timerTv"/>



    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/verifyOtpTil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:outlineAmbientShadowColor="@color/yellow"
        app:layout_constraintEnd_toEndOf="@id/sendOtpBtn"
        app:layout_constraintStart_toStartOf="@id/sendOtpBtn"
        app:layout_constraintTop_toBottomOf="@+id/sendOtpBtn">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/verifyOtpEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:hint="@string/enter_otp"
            android:inputType="phone"
            android:maxLength="6"
            android:textColor="@color/yellow"
            android:textColorHint="@color/yellow"
            android:textSize="20sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/verifyOtpBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16dp"
        android:visibility="gone"
        android:backgroundTint="@color/yellow"
        android:text="@string/verify_otp"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/verifyOtpTil"
        app:layout_constraintStart_toStartOf="@id/verifyOtpTil"
        app:layout_constraintTop_toBottomOf="@+id/verifyOtpTil" />

