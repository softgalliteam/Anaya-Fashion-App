<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Toolbar -->
        <TextView
            android:id="@+id/commonToolbar"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="@string/my_cart"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toTopOf="parent"/>


        <!-- Address -->
        <LinearLayout
            android:id="@+id/addressLl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@color/Platinum"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/changeAddressBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/commonToolbar">


            <TextView
                android:id="@+id/deliverToTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deliver To: NA"
                android:textColor="@color/black"/>


            <TextView
                android:id="@+id/addressTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NA"
                android:textColor="@color/black"/>

        </LinearLayout>


        <!-- Change Button -->
        <Button
            android:id="@+id/changeAddressBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change"
            android:textColor="@color/blue"
            android:background="@drawable/gray_border"
            android:backgroundTint="@color/white"
            app:layout_constraintTop_toTopOf="@id/addressLl"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Coupons And Offers -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/computerRV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/changeAddressBtn"
            tools:listitem="@layout/lahanga_list_item" />

        <androidx.cardview.widget.CardView
            android:id="@+id/offerCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="20dp"
            app:layout_constraintTop_toBottomOf="@id/computerRV"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Coupon Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coupons and Offers"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/gradiant_color">


                <!-- Best Coupon -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEST COUPON"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"/>



                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@color/white"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white"
                        android:gravity="center_vertical"
                        android:padding="16dp">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Save ₹189 with NFNEW15"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                android:textStyle="bold"/>


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Only for your 1st Order"
                                android:textSize="12sp"
                                android:textColor="@color/black"/>


                        </LinearLayout>


                        <Button
                            android:layout_width="90dp"
                            android:layout_height="50dp"
                            android:text="Apply"/>


                    </LinearLayout>


                </androidx.cardview.widget.CardView>



                <!-- Payment Offer -->
                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAYMENT OFFERS"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"/>



                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@color/white"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="12dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:text="Cashback upto ₹100
                        Get up to ₹100 cashback with BHIM..."
                        android:textColor="@color/black"
                        android:background="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />


                </androidx.cardview.widget.CardView>


            </LinearLayout>


        </androidx.cardview.widget.CardView>



        <!-- Buy Button -->
        <Button
            android:id="@+id/buyNowBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Buy Now"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/black"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/offerCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>



        <!-- Loader -->
        <LinearLayout
            android:id="@+id/loaderLl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


        </LinearLayout>


        <!-- Error -->
        <TextView
            android:id="@+id/errorTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/something_went_wrong"
            android:textColor="@color/red"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.core.widget.NestedScrollView>