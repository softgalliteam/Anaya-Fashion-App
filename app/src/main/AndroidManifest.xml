<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Location permissions for fetching user address -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name="com.anaya.fashion.AnayaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:theme="@style/Theme.AnayaFashion"
        tools:targetApi="31">
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name="com.anaya.fashion.view.SplashActivity"
            android:exported="true">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <activity android:name="com.anaya.fashion.view.DashboardActivity" />
        <activity android:name="com.anaya.fashion.view.LoginActivity" />
        <activity android:name="com.anaya.fashion.view.LahangaListActivity" />
        <activity android:name="com.anaya.fashion.view.LahangaDetailsActivity" />
        <activity android:name="com.anaya.fashion.view.CartActivity" />
        <activity android:name="com.anaya.fashion.view.OffersActivity" />
        <activity android:name="com.anaya.fashion.view.BuyActivity" />


        <activity android:name="com.anaya.fashion.view.ActivityA"
            android:launchMode="singleInstance"/>
        <activity android:name="com.anaya.fashion.view.ActivityB" />
        <activity android:name="com.anaya.fashion.view.ActivityC" />
        <activity android:name="com.anaya.fashion.view.ActivityD" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>